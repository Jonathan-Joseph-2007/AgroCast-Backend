# ═══════════════════════════════════════════════════
# AgroCast — .gitignore
# ═══════════════════════════════════════════════════

# ─── Environment & Secrets ────────────────────────
.env

# ─── Python Virtual Environments ──────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ─── Byte-compiled / Optimized / DLL files ────────
__pycache__/
*.py[cod]
*$py.class

# ─── ML Model Artifacts ──────────────────────────
ml/*.pkl

# ─── Generated Audio Files ───────────────────────
static/*.mp3
twilio_static/*.mp3

# ─── Cache & Temp Files ──────────────────────────
geocoding_cache.json
*.wav
temp.wav

# ─── Jupyter Notebook ────────────────────────────
.ipynb_checkpoints/

# ─── Testing ─────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ─── Type Checkers ───────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ─── IDE Settings ────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── macOS ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Logs ────────────────────────────────────────
logs/
*.log
*log*.txt
